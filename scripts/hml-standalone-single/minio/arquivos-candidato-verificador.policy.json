{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LeERemoveOEnvio",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::uniplus-candidato-envio/*"
      ]
    },
    {
      "Sid": "PromoveEReconheceOArquivoLimpo",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::uniplus-candidato-definitivo/*"
      ]
    },
    {
      "Sid": "ListaOsBucketsComoOSdkExige",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::uniplus-candidato-envio",
        "arn:aws:s3:::uniplus-candidato-definitivo"
      ]
    }
  ]
}
