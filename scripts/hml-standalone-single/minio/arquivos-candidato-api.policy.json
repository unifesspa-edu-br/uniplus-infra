{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AssinaOEnvio",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::uniplus-candidato-envio/*"
      ]
    },
    {
      "Sid": "LeEExcluiOArquivoVerificado",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::uniplus-candidato-definitivo/*"
      ]
    }
  ]
}
