{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LeEscreveOsObjetosDoBucket",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::tempo-traces/*"
      ]
    },
    {
      "Sid": "ListaOBucketComoOSdkExige",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::tempo-traces"
      ]
    }
  ]
}
