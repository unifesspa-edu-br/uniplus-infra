{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/unifesspa-edu-br/uniplus-infra/platform/observability/grafana/values.schema.json",
  "title": "grafana chart values",
  "description": "Schema mínimo dos values do chart wrapper. Subchart grafana/grafana tem seu próprio schema; additionalProperties=true em todos os blocos permite passar overrides validados pelo upstream.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "grafana": {
      "type": "object",
      "description": "Bloco do subchart grafana/grafana.",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Liga/desliga o subchart."
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "admin": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "existingSecret": {
              "type": "string",
              "description": "Nome do Secret com a conta de administrador."
            },
            "userKey": {
              "type": "string"
            },
            "passwordKey": {
              "type": "string"
            }
          }
        },
        "externalSecrets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "refreshInterval": {
              "type": "string"
            },
            "secretStoreRef": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              }
            },
            "oidcClient": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "vaultPath": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Caminho no KV da store (ex.: keycloak/grafana)."
                },
                "secretName": { "type": "string", "minLength": 1 },
                "property": { "type": "string", "minLength": 1 }
              }
            },
            "admin": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "vaultPath": {
                  "type": "string",
                  "description": "Caminho no KV da store (ex.: grafana/admin)."
                },
                "secretName": {
                  "type": "string",
                  "minLength": 1
                },
                "userProperty": {
                  "type": "string"
                },
                "passwordProperty": {
                  "type": "string"
                }
              }
            }
          }
        },
        "ingressRoute": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "host": {
              "type": "string"
            },
            "pathPrefix": {
              "type": "string"
            },
            "serviceName": {
              "type": "string"
            },
            "servicePort": {
              "type": "integer"
            },
            "middlewares": {
              "type": "array"
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
