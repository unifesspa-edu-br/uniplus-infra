      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "1 = a última falha é posterior ao último envio aceito (janela de 2 horas); o alerta dispara após 15 minutos nessa condição."
