      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "clamp_max(max_over_time(max(uniplus_email_ultima_falha_seconds{service_namespace=\"uniplus\"})[2h:]) > bool max_over_time(max(uniplus_email_ultimo_envio_seconds{service_namespace=\"uniplus\"})[2h:]), 1)",
          "legendFormat": "falha mais recente que o aceite",
          "refId": "A"
        }
