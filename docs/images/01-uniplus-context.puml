@startuml C4_Context_UniPlus
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

' ==========================================
' Diagrama C4 Nível 1 - System Context
' Projeto Uni+ - UNIFESSPA
' ==========================================

LAYOUT_WITH_LEGEND()
title Diagrama de Contexto - Sistema Uni+ \nUNIFESSPA / CTIC

' --- Atores (Personas) ---
Person(candidato, "Candidato", "Pessoa interessada em ingressar na UNIFESSPA via processo seletivo")
Person(aluno, "Aluno", "Estudante matriculado na UNIFESSPA")
Person(servidor, "Servidor", "Docente ou técnico-administrativo da UNIFESSPA")
Person(gestor, "Gestor Acadêmico", "Coordenador de processos seletivos e ingresso")

' --- Sistema central ---
System(uniplus, "Sistema Uni+", "Plataforma institucional unificada para processos seletivos, ingresso e portal acadêmico")

' --- Sistemas externos ---
System_Ext(govbr, "Gov.br", "Provedor de identidade do Governo Federal\n(login único + 2FA)")
System_Ext(oidc_pa1, "pa1-oidc-source", "OIDC institucional\n(PA1, assíncrono)")
System_Ext(ldap_uf, "LDAP/AD UNIFESSPA", "Diretório institucional\nde alunos e servidores")
System_Ext(object_pa1, "pa1-object-storage", "Storage de objetos\ninstitucional")
System_Ext(backup_pa1, "pa1-backup", "Infraestrutura interna de\nbackup e DR")
System_Ext(email, "Servidor de E-mail", "Sistema institucional de\ne-mail UNIFESSPA")

' --- Relacionamentos ---
Rel(candidato, uniplus, "Inscreve-se em editais,\nacompanha resultados", "HTTPS")
Rel(aluno, uniplus, "Acessa portal,\ngerencia matrícula", "HTTPS")
Rel(servidor, uniplus, "Consulta dados,\noperações administrativas", "HTTPS")
Rel(gestor, uniplus, "Gerencia editais,\nclassificação e ingresso", "HTTPS")

Rel(uniplus, govbr, "Autentica usuários", "OIDC / HTTPS")
Rel(uniplus, oidc_pa1, "Sincroniza metadados\nquando disponível", "OIDC / HTTPS")
Rel(oidc_pa1, ldap_uf, "Sincroniza usuários", "LDAPS")

Rel_R(uniplus, object_pa1, "Replica documentos\n(off-site)", "S3 API")
Rel_R(uniplus, backup_pa1, "Envia backups\n(noturno)", "SSH/rsync")
Rel(uniplus, email, "Envia notificações\ne comunicados", "SMTP")

SHOW_LEGEND()

@enduml
