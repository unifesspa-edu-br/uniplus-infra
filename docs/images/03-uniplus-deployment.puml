@startuml C4_Deployment_UniPlus
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Deployment.puml

' ==========================================
' Diagrama C4 Nível 4 - Deployment (topologia)
' Projeto Uni+ - UNIFESSPA
' ==========================================

LAYOUT_WITH_LEGEND()
title Diagrama de Deployment - Topologia Física \nProjeto Uni+ (UNIFESSPA / CTIC)

Person(usuario, "Usuário Uni+", "Acesso via internet pública")

Deployment_Node(edge_lab, "Entrada HTTP/TLS de lab", "Acesso provisório", "DNS/tunnel provisório") {
    Container(edge_proxy, "Proxy de entrada", "Lab", "Roteamento para SP1/SP2")
}

Deployment_Node(eveo, "EVEO — Datacenter Tier III") {

    Deployment_Node(sp1, "SP1 — Cotia (zona disponibilidade A)", "Servidor Dedicado") {
        Deployment_Node(sp1_hw, "Hardware", "Intel Xeon Gold 6138 / 96 GB / 2 TB NVMe RAID 1") {
            Deployment_Node(sp1_os, "Ubuntu Server 24.04 LTS", "OS Linux") {

                Deployment_Node(sp1_k8s, "Cluster Kubernetes A", "K8s single-node + control plane") {
                    Container(sp1_apps, "Aplicações Uni+", "Pods", "Frontends, APIs,\nClamAV, Traefik,\nOIDC, Vault,\nObservabilidade")
                }

                Deployment_Node(sp1_host, "Containers no host (systemd)", "Docker/Podman") {
                    ContainerDb(sp1_pg, "PostgreSQL × 3", "PG 16 + Patroni", "Portal (P), Seleção (R),\nIngresso (P)")
                    ContainerQueue(sp1_kafka, "Kafka Broker", "Apache Kafka KRaft", "Brokers 1-2")
                    ContainerDb(sp1_minio, "MinIO Node", "MinIO Distribuído", "Buckets distribuídos")
                }
            }
        }
    }

    Deployment_Node(sp2, "SP2 — Osasco (zona disponibilidade B)", "Servidor Dedicado") {
        Deployment_Node(sp2_hw, "Hardware", "Intel Xeon Gold 6138 / 96 GB / 2 TB NVMe RAID 1") {
            Deployment_Node(sp2_os, "Ubuntu Server 24.04 LTS", "OS Linux") {

                Deployment_Node(sp2_k8s, "Cluster Kubernetes B", "K8s single-node + control plane") {
                    Container(sp2_apps, "Aplicações Uni+", "Pods", "Frontends, APIs,\nClamAV, Traefik,\nOIDC, Vault,\nObservabilidade")
                }

                Deployment_Node(sp2_host, "Containers no host (systemd)", "Docker/Podman") {
                    ContainerDb(sp2_pg, "PostgreSQL × 3", "PG 16 + Patroni", "Portal (R), Seleção (P),\nIngresso (R)")
                    ContainerQueue(sp2_kafka, "Kafka Broker", "Apache Kafka KRaft", "Broker 3")
                    ContainerDb(sp2_minio, "MinIO Node", "MinIO Distribuído", "Buckets distribuídos")
                }
            }
        }
    }
}

Deployment_Node(unifesspa, "UNIFESSPA — Marabá-PA", "Infraestrutura institucional interna") {
    Deployment_Node(uf_palo, "Palo Alto", "NGFW institucional") {
        Container(uf_fw, "Firewall + IPSEC", "Palo Alto", "Termina túneis,\nfiltra tráfego")
    }
    Deployment_Node(uf_servers, "Servidores institucionais", "Linux VMs") {
        Container(uf_oidc, "pa1-oidc-source", "OIDC", "Fonte institucional de identidade")
        Container(uf_ldap, "LDAP/AD", "OpenLDAP / AD", "Diretório de usuários")
        ContainerDb(uf_object, "pa1-object-storage", "S3 compatível", "Storage institucional")
        ContainerDb(uf_backup, "pa1-backup", "NAS / SAN", "pgBackRest repo,\nreplicação de objetos")
        Container(uf_consensus, "pa1-consensus-witness", "etcd", "Função opcional de quorum")
    }
}

System_Ext(govbr_ext, "Gov.br", "OIDC")

' --- Conexões físicas ---
Rel(usuario, edge_proxy, "HTTPS")
Rel(edge_proxy, sp1_apps, "HTTPS\n(endpoint SP1)")
Rel(edge_proxy, sp2_apps, "HTTPS\n(endpoint SP2)")

Rel_R(sp1_pg, sp2_pg, "Replicação streaming\n(L2L 500 Mbps privado)", "TCP/5432")
Rel_R(sp1_kafka, sp2_kafka, "Replicação\nKafka cluster", "TCP/9092")
Rel_R(sp1_minio, sp2_minio, "Replicação/healing\nnativo", "S3 API")

Rel_D(sp1_apps, uf_fw, "Túnel IPSEC", "ESP/UDP")
Rel_D(sp2_apps, uf_fw, "Túnel IPSEC", "ESP/UDP")

Rel(uf_fw, uf_oidc, "")
Rel(uf_fw, uf_object, "")
Rel(uf_fw, uf_backup, "")
Rel(uf_fw, uf_consensus, "")

Rel(uf_oidc, govbr_ext, "Federação OIDC", "HTTPS")

SHOW_LEGEND()

@enduml
